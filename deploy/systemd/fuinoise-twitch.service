[Unit]
Description=Refresh stored Fuinoise Twitch information
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fuinoise
Group=fuinoise
WorkingDirectory=/srv/fuinoise/current
EnvironmentFile=/etc/fuinoise/fuinoise.env
ExecStart=/usr/bin/env venv/bin/python manage.py refresh_twitch
TimeoutStartSec=180
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/fuinoise/data
