[Unit]
Description=Create a verified Fuinoise database snapshot

[Service]
Type=oneshot
User=fuinoise
Group=fuinoise
WorkingDirectory=/srv/fuinoise/current
EnvironmentFile=/etc/fuinoise/fuinoise.env
ExecStart=/usr/bin/env venv/bin/python manage.py backup_database --output-dir /srv/fuinoise/backups
ExecStart=/usr/bin/env venv/bin/python manage.py clearsessions
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/fuinoise/data /srv/fuinoise/backups
