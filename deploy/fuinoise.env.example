# Private server file: /etc/fuinoise/fuinoise.env (root:fuinoise, 0640).
# systemd EnvironmentFile syntax; no "export" or shell substitutions here.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_PRODUCTION_KEY
DJANGO_ALLOWED_HOSTS=fuinoise.example
DJANGO_TRUST_PROXY=1
FUINOISE_ORIGIN=https://fuinoise.example
FUINOISE_DATABASE_PATH=/srv/fuinoise/data/fuinoise.sqlite3
FUINOISE_STATIC_ROOT=/srv/fuinoise/current/staticfiles
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
DISCORD_ORGANIZER_CHANNEL_ID=
TWITCH_LIVE_MAX_AGE_SECONDS=180
