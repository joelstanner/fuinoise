# Local development settings. Copy to .env and enter your credentials.
# Existing terminal/server environment variables take precedence.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FUINOISE_ORIGIN=http://localhost:8000

# Required for Twitch sign-in and channel lookup.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional until Discord integration is configured.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
DISCORD_ORGANIZER_CHANNEL_ID=
